# Copy to .env (local) or set in Hostinger > Node.js app > Environment variables
PORT=3000
NODE_ENV=production
SITE_URL=https://www.next.edu.vn

# SMTP for the contact form (e.g. Hostinger email: smtp.hostinger.com, port 465)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=no-reply@next.edu.vn
SMTP_PASS=your-email-password
MAIL_FROM="Next Education Website <no-reply@next.edu.vn>"
MAIL_TO=dos@next.edu.vn

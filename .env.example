# Copy to .env (local) or set in Render > Environment / Hostinger > Node.js app > Environment variables
PORT=3000
NODE_ENV=production
# Set only once next.edu.vn points to this server
SITE_URL=https://next.edu.vn

# Contact form email via Google Workspace (Gmail) account dos@next.edu.vn
# SMTP_PASS must be a 16-character Google App Password, NOT the normal login password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=dos@next.edu.vn
SMTP_PASS=xxxxxxxxxxxxxxxx
MAIL_FROM="NEXT Website <dos@next.edu.vn>"
MAIL_TO=dos@next.edu.vn

# Google Analytics 4 (optional, defaults to the ID in src/data/site.js)
GA_MEASUREMENT_ID=G-SJHF20PQDT

<%- include('../partials/head', { title: t('nav.about'), description: t('about.story')[0], image: 'hd/d62-sm' }) %>
<%- include('../partials/page-hero', { bg: 'hd/a15', heading: t('about.title'), lead: t('about.lead'), eyebrow: t('brand.slogan'), crumbs: [{ label: t('nav.about') }] }) %>
<% const beliefImg = ['hd/a62', 'hd/b3', 'hd/d13', 'hd/c4']; const story = t('about.story'); %>

<section class="section">
  <div class="container split split-top">
    <div class="split-body reveal">
      <p class="eyebrow"><%= t('about.storyEyebrow') %></p>
      <h2><%= t('about.storyTitle') %></h2>
      <p class="lead-text"><%= story[0] %></p>
      <% story.slice(1, 3).forEach(p => { %><p><%= p %></p><% }) %>
    </div>
    <div class="split-media reveal">
      <div class="photo-stack">
        <%- include('../partials/pic', { name: 'hd/d62', cls: 'ps-main', alt: L({ en: 'NEXT group in Hoi An', vi: 'Đoàn NEXT tại Hội An' }) }) %>
        <%- include('../partials/pic', { name: 'hd/b4', cls: 'ps-sub', sizes: '(max-width: 900px) 50vw, 25vw', alt: L({ en: 'Basket boat ride in the coconut forest', vi: 'Đi thuyền thúng ở rừng dừa' }) }) %>
      </div>
    </div>
  </div>
  <div class="container prose-cols reveal">
    <% story.slice(3).forEach(p => { %><p><%= p %></p><% }) %>
  </div>
</section>

<section class="section vm">
  <div class="vm-media" aria-hidden="true"><%- include('../partials/pic', { name: 'hd/b31', alt: '', sizes: '100vw' }) %></div>
  <div class="container vm-grid">
    <% ['vision', 'mission'].forEach(k => { const v = t('about.' + k); %>
    <article class="vm-card reveal">
      <p class="eyebrow"><%= v.label %></p>
      <h2><%= v.title %></h2>
      <p><%= v.text %></p>
    </article>
    <% }) %>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow"><%= t('about.beliefs.eyebrow') %></p>
      <h2><%= t('about.beliefs.title') %></h2>
      <p><%= t('about.beliefs.text') %> <%= t('about.beliefs.intro') %></p>
    </div>
    <div class="belief-grid">
      <% t('about.beliefs.items').forEach((b, i) => { %>
      <article class="belief reveal">
        <%- include('../partials/pic', { name: beliefImg[i], alt: '', sizes: '(max-width: 600px) 100vw, (max-width: 1100px) 50vw, 25vw' }) %>
        <div class="belief-body">
          <p class="belief-name"><span><%= String(i + 1).padStart(2, '0') %></span> — <%= b.name %></p>
          <h3><%= b.title %></h3>
          <p><%= b.text %></p>
        </div>
      </article>
      <% }) %>
    </div>
  </div>
</section>

<section class="section section-tint">
  <div class="container values-layout">
    <div class="values-head reveal">
      <p class="eyebrow"><%= t('about.values.eyebrow') %></p>
      <h2><%= t('about.values.title') %></h2>
      <%- include('../partials/pic', { name: 'hd/c32', cls: 'values-img', alt: L({ en: 'Mentor and students working together', vi: 'Giáo viên và học sinh cùng làm việc' }) }) %>
    </div>
    <ol class="value-list">
      <% t('about.values.items').forEach((v, i) => { %>
      <li class="value reveal">
        <span class="value-num"><%= String(i + 1).padStart(2, '0') %></span>
        <div>
          <p class="value-name"><%= v.name %></p>
          <h3><%= v.title %></h3>
          <p><%= v.text %></p>
        </div>
      </li>
      <% }) %>
    </ol>
  </div>
</section>

<section class="section">
  <div class="container split">
    <div class="split-body reveal">
      <p class="eyebrow"><%= t('about.network.eyebrow') %></p>
      <h2><%= t('about.network.title') %></h2>
      <p class="lead-text"><%= t('about.network.lead') %></p>
      <% t('about.network.text').forEach(p => { %><p><%= p %></p><% }) %>
    </div>
    <div class="network-photos network-photos-3 reveal">
      <%- include('../partials/pic', { name: 'hd/d2', alt: L({ en: 'Visit to an international school', vi: 'Thăm trường quốc tế' }) }) %>
      <%- include('../partials/pic', { name: 'hd/d8', sizes: '(max-width: 900px) 50vw, 25vw', alt: L({ en: 'Camp group with partners', vi: 'Đoàn trại cùng đối tác' }) }) %>
      <%- include('../partials/pic', { name: 'hd/d69', sizes: '(max-width: 900px) 50vw, 25vw', alt: L({ en: 'Cultural visit', vi: 'Tham quan văn hóa' }) }) %>
    </div>
  </div>
  <div class="container partners reveal">
    <h3 class="partners-title"><%= t('about.partnersTitle') %></h3>
    <ul class="partner-logos">
      <% site.partners.forEach(p => { %><li<% if (p.h / p.w > 0.7) { %> class="logo-tall"<% } %>><img src="/images/partners/<%= p.key %>.webp" alt="<%= p.name %>" width="<%= p.w %>" height="<%= p.h %>" loading="lazy"></li><% }) %>
    </ul>
  </div>
</section>

<section class="section section-tint">
  <div class="container">
    <div class="section-head"><h2><%= t('about.officesTitle') %></h2></div>
    <div class="office-grid">
      <% site.offices.forEach(o => { %>
      <article class="office reveal">
        <%- include('../partials/icon', { name: 'map-pin', size: 24 }) %>
        <h3><%= L(o.city) %></h3>
        <p><%= L(o.address) %></p>
      </article>
      <% }) %>
    </div>
  </div>
</section>

<%- include('../partials/cta') %>
<%- include('../partials/foot') %>

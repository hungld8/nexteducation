<%- include('../partials/head', { title: '', description: '', image: 'hero-banner-sm' }) %>
<% const catImg = { learn: 'hd/d17', explore: 'hd/b30', connect: 'hd/d70', contribute: 'hd/d66' }; %>

<section class="hero">
  <div class="hero-media" aria-hidden="true">
    <img src="/images/hero-banner.webp" srcset="/images/hero-banner-sm.webp 1200w, /images/hero-banner.webp 2880w" sizes="100vw" alt="" width="2880" height="1922" fetchpriority="high">
  </div>
  <div class="container hero-content">
    <p class="eyebrow eyebrow-light"><%= t('home.eyebrow') %></p>
    <h1><%- t('home.title') %></h1>
    <p class="hero-lead"><%= t('home.lead') %></p>
    <div class="hero-actions">
      <a class="btn btn-primary btn-lg" href="<%= url('/programs') %>"><%= t('home.ctaPrimary') %> <%- include('../partials/icon', { name: 'arrow-right', size: 20 }) %></a>
      <a class="btn btn-ghost-light btn-lg" href="<%= url('/contact') %>"><%= t('home.ctaSecondary') %></a>
    </div>
  </div>
</section>

<section class="pillars" aria-label="NEXT">
  <div class="container"><dl class="pillars-grid">
    <% t('brand.pillars').forEach(p => { %>
    <div class="pillar"><dt><%= p.label %></dt><dd><%= p.value %></dd></div>
    <% }) %>
  </dl></div>
</section>

<section class="section">
  <div class="container split">
    <div class="split-media reveal">
      <div class="photo-stack">
        <%- include('../partials/pic', { name: 'hd/d62', cls: 'ps-main', alt: L({ en: 'NEXT student group in Hoi An', vi: 'Đoàn học sinh của NEXT tại Hội An' }) }) %>
        <%- include('../partials/pic', { name: 'hd/a61', cls: 'ps-sub', sizes: '(max-width: 900px) 50vw, 25vw', alt: L({ en: 'Hands-on craft workshop', vi: 'Hoạt động thủ công thực hành' }) }) %>
      </div>
    </div>
    <div class="split-body reveal">
      <p class="eyebrow"><%= t('home.introEyebrow') %></p>
      <h2><%= t('home.introTitle') %></h2>
      <% t('home.intro').forEach((p, i) => { %><p class="<%= i === 0 ? 'lead-text' : '' %>"><%= p %></p><% }) %>
      <p class="tagline"><%= t('home.tagline') %></p>
      <a class="link-arrow" href="<%= url('/about') %>"><%= t('home.introLink') %> <%- include('../partials/icon', { name: 'arrow-right', size: 18 }) %></a>
    </div>
  </div>
</section>

<section class="section section-tint">
  <div class="container">
    <div class="section-head section-head-row">
      <div>
        <p class="eyebrow"><%= t('home.programsEyebrow') %></p>
        <h2><%= t('home.programsTitle') %></h2>
        <p><%= t('home.programsText') %></p>
      </div>
      <a class="link-arrow" href="<%= url('/programs') %>"><%= t('home.programsLink') %> <%- include('../partials/icon', { name: 'arrow-right', size: 18 }) %></a>
    </div>
    <div class="cat-grid">
      <% t('programs.categories').forEach((c, i) => { %>
      <a class="cat-card reveal" href="<%= url('/programs') %>#<%= c.key %>">
        <%- include('../partials/pic', { name: catImg[c.key], alt: '', sizes: '(max-width: 600px) 100vw, (max-width: 1100px) 50vw, 25vw' }) %>
        <span class="cat-body">
          <span class="cat-num"><%= String(i + 1).padStart(2, '0') %></span>
          <span class="cat-name"><%= c.name %></span>
          <span class="cat-label"><%= c.label %></span>
          <span class="cat-title"><%= c.title %></span>
        </span>
      </a>
      <% }) %>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-head section-head-row">
      <div>
        <p class="eyebrow"><%= t('home.whyEyebrow') %></p>
        <h2><%= t('home.whyTitle') %></h2>
      </div>
      <a class="link-arrow" href="<%= url('/why-next') %>"><%= t('home.whyLink') %> <%- include('../partials/icon', { name: 'arrow-right', size: 18 }) %></a>
    </div>
    <ol class="why-list why-list-compact">
      <% t('why.items').forEach((w, i) => { %>
      <li class="why-item reveal">
        <span class="why-num"><%= String(i + 1).padStart(2, '0') %></span>
        <h3><%= w.name %></h3>
        <p><%= w.title %></p>
      </li>
      <% }) %>
    </ol>
  </div>
</section>

<section class="section dest">
  <div class="container split split-reverse">
    <div class="split-body reveal">
      <p class="eyebrow eyebrow-light"><%= t('programs.vietnam.eyebrow') %></p>
      <h2><%= t('programs.vietnam.title') %></h2>
      <% t('programs.vietnam.text').forEach((p, i) => { %><p class="<%= i === 0 ? 'lead-text' : '' %>"><%= p %></p><% }) %>
    </div>
    <div class="dest-mosaic reveal">
      <%- include('../partials/pic', { name: 'hd/a31', alt: L({ en: 'Hoi An from above', vi: 'Hội An nhìn từ trên cao' }) }) %>
      <%- include('../partials/pic', { name: 'hd/b31', sizes: '(max-width: 900px) 50vw, 25vw', alt: L({ en: 'Mountains of Central Vietnam', vi: 'Núi rừng miền Trung' }) }) %>
      <%- include('../partials/pic', { name: 'hd/a15', sizes: '(max-width: 900px) 50vw, 25vw', alt: L({ en: 'Evening walk in Hoi An Ancient Town', vi: 'Dạo phố cổ Hội An buổi tối' }) }) %>
    </div>
  </div>
</section>

<section class="section section-tint">
  <div class="container">
    <div class="section-head section-head-row">
      <div>
        <p class="eyebrow"><%= t('home.galleryEyebrow') %></p>
        <h2><%= t('home.galleryTitle') %></h2>
      </div>
      <a class="link-arrow" href="<%= url('/gallery') %>"><%= t('home.galleryLink') %> <%- include('../partials/icon', { name: 'arrow-right', size: 18 }) %></a>
    </div>
    <div class="gallery-strip" data-gallery>
      <% gallery.slice(0, 8).forEach((g, i) => { %>
      <button type="button" class="gallery-item gi-<%= i %>" data-lb-src="/images/<%= g.src %>.webp" data-lb-alt="<%= L(g.alt) %>">
        <%- include('../partials/pic', { name: g.src, alt: L(g.alt), sizes: '(max-width: 900px) 50vw, 25vw' }) %>
      </button>
      <% }) %>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow"><%= t('home.testiEyebrow') %></p>
      <h2><%= t('home.testiTitle') %></h2>
    </div>
    <div class="testi-grid">
      <% site.testimonials.forEach(tm => { %>
      <figure class="testi reveal">
        <%- include('../partials/icon', { name: 'quote', size: 28, className: 'icon testi-quote' }) %>
        <blockquote><p><%= L(tm.text) %></p></blockquote>
        <figcaption>
          <span class="testi-avatar" aria-hidden="true"><%= tm.name.replace(/^(Mr\.|Ms\.)\s*/, '').charAt(0) %></span>
          <span><strong><%= tm.name %></strong><small><%= L(tm.role) %></small></span>
        </figcaption>
      </figure>
      <% }) %>
    </div>
  </div>
</section>

<%- include('../partials/cta') %>
<%- include('../partials/foot') %>

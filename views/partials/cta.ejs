<section class="cta-band">
  <div class="container cta-inner">
    <div>
      <p class="eyebrow eyebrow-light"><%= t('cta.eyebrow') %></p>
      <h2><%= t('cta.title') %></h2>
      <p><%= t('cta.text') %></p>
    </div>
    <div class="cta-actions">
      <a class="btn btn-white btn-lg" href="<%= url('/contact') %>"><%= t('cta.button') %> <%- include('icon', { name: 'arrow-right', size: 20 }) %></a>
      <a class="cta-phone" href="<%= site.hotlineHref %>"><%- include('icon', { name: 'phone', size: 18 }) %> <%= site.hotline %> (<%= site.contactPerson %>)</a>
    </div>
  </div>
</section>

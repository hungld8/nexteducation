</main>
<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <img src="/img/logo-white.png" alt="NEXT" width="160" height="42" loading="lazy">
      <p><%= t('footer.about') %></p>
      <div class="footer-social">
        <a href="<%= site.whatsapp %>" target="_blank" rel="noopener" aria-label="WhatsApp">WhatsApp</a>
        <a href="<%= site.zalo %>" target="_blank" rel="noopener" aria-label="Zalo">Zalo</a>
      </div>
    </div>
    <div>
      <h2 class="footer-title"><%= t('footer.explore') %></h2>
      <ul class="footer-links">
        <li><a href="<%= url('/about') %>"><%= t('nav.about') %></a></li>
        <li><a href="<%= url('/programs') %>"><%= t('nav.programs') %></a></li>
        <li><a href="<%= url('/why-next') %>"><%= t('nav.why') %></a></li>
        <li><a href="<%= url('/gallery') %>"><%= t('nav.gallery') %></a></li>
      </ul>
    </div>
    <div>
      <h2 class="footer-title"><%= t('footer.contact') %></h2>
      <ul class="footer-contact">
        <li><%- include('icon', { name: 'phone', size: 18 }) %><a href="<%= site.hotlineHref %>"><%= site.hotline %> (<%= site.contactPerson %>)</a></li>
        <li><%- include('icon', { name: 'message-circle', size: 18 }) %><span>WhatsApp · Zalo</span></li>
        <li><%- include('icon', { name: 'mail', size: 18 }) %><a href="mailto:<%= site.email %>"><%= site.email %></a></li>
        <li><%- include('icon', { name: 'map-pin', size: 18 }) %><span><%= L(site.offices[0].address) %></span></li>
      </ul>
    </div>
  </div>
  <div class="container footer-bottom">
    <p>© <%= year %> NEXT. <%= t('footer.rights') %></p>
    <ul class="footer-langs" aria-label="<%= t('nav.language') %>">
      <% languages.forEach(l => { %><li><a href="<%= l.href %>" hreflang="<%= l.hreflang %>" lang="<%= l.html %>" <% if (l.current) { %>aria-current="true"<% } %>><%= l.label %></a></li><% }) %>
    </ul>
  </div>
</footer>
<a class="float-chat" href="<%= site.whatsapp %>" target="_blank" rel="noopener" aria-label="WhatsApp <%= site.hotline %>">
  <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.47 14.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.64.07-.3-.15-1.25-.46-2.39-1.47-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.6.13-.14.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.06 2.88 1.21 3.08c.15.2 2.1 3.2 5.08 4.48.71.31 1.26.49 1.69.63.71.23 1.36.2 1.87.12.57-.09 1.75-.72 2-1.41.25-.69.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35M12.05 21.79h-.01a9.87 9.87 0 0 1-5.03-1.38l-.36-.21-3.74.98 1-3.65-.24-.37a9.86 9.86 0 0 1-1.51-5.26c0-5.45 4.44-9.88 9.9-9.88 2.64 0 5.12 1.03 6.99 2.9a9.82 9.82 0 0 1 2.89 6.99c0 5.45-4.44 9.88-9.89 9.88m8.41-18.3A11.81 11.81 0 0 0 12.05 0C5.5 0 .16 5.34.16 11.89c0 2.1.55 4.14 1.59 5.95L.06 24l6.31-1.65a11.88 11.88 0 0 0 5.68 1.45h.01c6.55 0 11.89-5.34 11.89-11.89 0-3.18-1.24-6.16-3.48-8.41"/></svg>
</a>
<div class="lightbox" data-lightbox hidden role="dialog" aria-modal="true" aria-label="<%= t('nav.gallery') %>">
  <button class="lb-btn lb-close" type="button" data-lb-close aria-label="<%= t('gallery.close') %>"><%- include('icon', { name: 'x' }) %></button>
  <button class="lb-btn lb-prev" type="button" data-lb-prev aria-label="<%= t('gallery.prev') %>"><%- include('icon', { name: 'chevron-left' }) %></button>
  <figure><img alt="" data-lb-img><figcaption data-lb-cap></figcaption></figure>
  <button class="lb-btn lb-next" type="button" data-lb-next aria-label="<%= t('gallery.next') %>"><%- include('icon', { name: 'chevron-right' }) %></button>
</div>
<script src="/js/main.js?v=3" defer></script>
</body>
</html>
